# Exemplo de .env para Boletim Diplomático

# Configurações de e-mail
EMAIL_HOST=smtp.seudominio.gov.br
EMAIL_PORT=587
EMAIL_USER=seu_email@dominio.gov.br
EMAIL_PASSWORD=sua_senha_ou_senha_app
EMAIL_USE_TLS=True
EMAIL_FROM=seu_email@dominio.gov.br
EMAIL_TO=destinatario@dominio.gov.br

# Configuração alternativa Gmail
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu_email@gmail.com
# EMAIL_PASSWORD=sua_senha_app
# EMAIL_USE_TLS=True

# Configuração do modelo
MODEL_PATH=/caminho/para/modelo/llama3
MODEL_NAME=llama-3-8b-instruct.Q4_K_M.gguf

# Fuso horário local (ex: America/Sao_Paulo)
TIMEZONE=America/Sao_Paulo

# Caminho para logs
LOG_PATH=logs/boletim.log
