{
  "name": "Notas do Dia",
  "description": "Sistema de scraping e resumo automático de comunicados diplomáticos do governo da Índia",
  "repository": "https://github.com/tacianoz/notas-do-dia",
  "logo": "https://node-js-sample.herokuapp.com/node.png",
  "keywords": ["python", "flask", "scraping", "diplomacy"],
  "buildpacks": [
    {
      "url": "heroku/python"
    },
    {
      "url": "https://github.com/heroku/heroku-buildpack-google-chrome"
    },
    {
      "url": "https://github.com/heroku/heroku-buildpack-chromedriver"
    }
  ],
  "env": {
    "GOOGLE_API_KEY": {
      "description": "Chave da API do Google Gemini",
      "required": true
    },
    "EMAIL_HOST": {
      "description": "Servidor SMTP (ex: smtp.gmail.com)",
      "value": "smtp.gmail.com"
    },
    "EMAIL_PORT": {
      "description": "Porta SMTP",
      "value": "587"
    },
    "EMAIL_USER": {
      "description": "Usuário do email",
      "required": true
    },
    "EMAIL_PASSWORD": {
      "description": "Senha do email (App Password para Gmail)",
      "required": true
    },
    "EMAIL_USE_TLS": {
      "description": "Usar TLS",
      "value": "True"
    },
    "EMAIL_FROM": {
      "description": "Email remetente",
      "required": true
    },
    "EMAIL_TO": {
      "description": "Email destinatário (pode ser múltiplos separados por vírgula)",
      "required": true
    },
    "TIMEZONE": {
      "description": "Timezone",
      "value": "Asia/Kolkata"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "standard-1x"
    }
  }
}

